# This workspace also contains local course archives and generated files.
# Keep the public repository allowlisted so `git add .` cannot include them.
/*

# Public project files
!/.github/
!/.github/**
!/.openai/
!/.openai/hosting.json
!/.env.example
!/.gitattributes
!/.gitignore
!/.nvmrc
!/LICENSE
!/README.md
!/SECURITY.md
!/content/
!/content/**
!/env.d.ts
!/index.html
!/materials/
!/materials/**
!/package-lock.json
!/package.json
!/public/
!/public/**
!/scripts/
!/scripts/**
!/src/
!/src/**
!/tsconfig.app.json
!/tsconfig.json
!/tsconfig.node.json
!/vite.config.ts
!/wrangler.toml

# Defense in depth for generated or private files under allowlisted folders
**/node_modules/
**/dist/
**/.env
**/.env.*
!/.env.example
**/__pycache__/
**/*.py[cod]
**/*.log
**/*.local
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
